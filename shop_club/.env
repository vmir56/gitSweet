# shop_club/.env

# Основные настройки
APP_NAME="Shop Club"
APP_VERSION="1.0.0"
DEBUG=True
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
SECRET_KEY=your-super-secret-key-change-me-in-production
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# База данных DATABASE_URL = "sqlite:///./test.db"    #=postgresql+asyncpg://v.ant@localhost:5432/shop_db
DATABASE_URL=postgresql+asyncpg://v.ant@localhost:5432/shop_club_db

# Подключение к price_spider
SPIDER_URL=http://localhost:8001
SPIDER_API_KEYS=shop_club_2026_7f2k9m8q
SPIDER_TIMEOUT=120

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Кеширование (будет Redis)
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600

# Безопасность
BCRYPT_ROUNDS=12

# Пагинация
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Celery (будет нужен)
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Мониторинг
# SENTRY_DSN=https://your-sentry-dsn